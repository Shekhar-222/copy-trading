# Copy this file to .env and fill in real values.
# ENCRYPTION_KEY is used to encrypt API secrets / TOTP secrets / access tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SQLite file location (default is fine for local use)
DATABASE_URL=sqlite:///./copytrader.db

# CORS - the origin your React dev server / production frontend runs on
FRONTEND_ORIGIN=http://localhost:5173
