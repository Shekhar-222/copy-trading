# Copy this file to .env and fill in real values.
# ENCRYPTION_KEY is used to encrypt API secrets / TOTP secrets / access tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SQLite file location. Default is fine for local use. If deployed on a host with a mounted
# persistent volume (e.g. Railway), point this at a path inside that volume so the DB survives
# restarts/redeploys, e.g.: sqlite:////data/copytrader.db
DATABASE_URL=sqlite:///./copytrader.db

# CORS - comma-separated list of origins your frontend runs on, e.g.
# http://localhost:5173,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Shared access code gating the entire API/dashboard once this is deployed somewhere reachable
# off localhost (this app places real orders and has no per-user accounts, so it needs *some*
# gate before being public). Leave unset for local-only use. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_ACCESS_TOKEN=

# Telegram digest (individual + total P&L, plus new trade log lines) sent every 60s once the
# first order of the session has actually been placed - see telegram_notify.py. Leave both unset
# to disable; the app runs fine without them.
#   TELEGRAM_BOT_TOKEN - from @BotFather after creating a bot (BotFather sends it to you as
#     "123456789:AA...", the whole string including the colon)
#   TELEGRAM_CHAT_ID - comma-separated list of chat ids to send to, e.g. your own numeric DM id
#     plus a channel's id/username, to broadcast the same digest to more than one place:
#       TELEGRAM_CHAT_ID=900086804,@your_channel_username
#     A personal account's numeric id only comes from messaging the bot first (or asking
#     @userinfobot); a channel needs the bot added as an Administrator to that channel first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
